{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "keeper-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "cal.jeryn.me", "custom_domain": true }],
  "observability": { "enabled": true },
  // The dashboard (applications/web, built with vite). The Worker runs first on every
  // request, so the Access check guards the app's files as well as its API.
  "assets": {
    "directory": "../../applications/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Every minute: name the units of work and queue them.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keeper-cf",
      "database_id": "b995e41d-32c1-430f-a3ca-57bd3671871b",
      "migrations_dir": "../database/migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "keeper-sync" }],
    "consumers": [
      {
        "queue": "keeper-sync",
        // One calendar per invocation, so one slow provider cannot eat another's budget.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 4
      }
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://cal.jeryn.me",
    // From the Access application in front of this hostname.
    "ACCESS_TEAM_DOMAIN": "https://spring-hat-2036.cloudflareaccess.com",
    "ACCESS_AUD": "6add0cd60e8ac75d67e15c030ba9e54e36d2a1e01fd4d3f4ba11bb620d7c2cbf",
    "SOURCE_URL": "https://github.com/jerynv/keeper.wk",
    "TIMEZONE": "America/Indiana/Indianapolis"
  }
  // Secrets (wrangler secret put): ENCRYPTION_KEY, OWNER_EMAIL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
}
