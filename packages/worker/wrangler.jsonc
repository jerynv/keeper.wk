{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "keeper-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The dashboard (applications/web, built with vite). The Worker runs first on every
  // request, so the Access check guards the app's files as well as its API.
  "assets": {
    "directory": "../../applications/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Every minute: name the units of work and queue them.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keeper-cf",
      // Placeholder until the database is created in Phase 6; `wrangler dev` ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../database/migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "keeper-sync" }],
    "consumers": [
      {
        "queue": "keeper-sync",
        // One calendar per invocation, so one slow provider cannot eat another's budget.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 4
      }
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://cal.jeryn.me",
    // Filled in Phase 6 from the Access application: https://<team>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "SOURCE_URL": "https://github.com/ridafkih/keeper.sh",
    "TIMEZONE": "America/Indiana/Indianapolis"
  }
  // Secrets (wrangler secret put): ENCRYPTION_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
}
