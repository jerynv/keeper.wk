{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/*.css",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**/*",
    "scripts/**/*"
  ],
  "ignoreBinaries": [],
  "ignoreWorkspaces": [
    "packages/typescript-config"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "packages/*": {
      "project": "src/**/*.{ts,tsx}"
    }
  },
  "ignoreDependencies": [
    "cloudflare",
    "@cloudflare/workers-types",
    "@cloudflare/vitest-plugin"
  ]
}
