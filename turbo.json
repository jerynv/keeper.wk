{
  "$schema": "https://v2-9-0.turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CI"
  ],
  "tasks": {
    "types": {
      "dependsOn": [
        "^types"
      ],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        ".oxlintrc.json",
        "../../.oxlintrc.json"
      ],
      "cache": true
    }
  }
}
